# 复制为 .env 后按需修改（.env 已在 .gitignore，勿提交）
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# 日记目录（覆盖 config.yaml 的 data.diary_dir）
# 相对路径以 My_rag/ 为根；楊基振全文建议：
# DIARY_DIR=data/diary_sinica
# DIARY_DIR=data/diary
# DIARY_DIR=../sinica_ith_diary_corpus/export

# 中研院语料导入（scripts/import_sinica.py）
# SINICA_CORPUS_PATH=../sinica_ith_diary_corpus/diary_corpus.csv
# SINICA_AUTHOR=楊基振日記
# ENTITY_SAMPLE_RATIO=1.0

# 候选词表 V（scripts/build_vocabulary.py，覆盖 config.yaml vocabulary 段）
# VOCAB_SIZE=5000
# VOCAB_MIN_DF_RATIO=0.03
# VOCAB_MAX_DF_RATIO=0.50
# VOCAB_MIN_DF_ABS=3
# VOCAB_MIN_TOTAL_TF=3
# VOCAB_SORT_BY=tf_idf
# VOCAB_OUTPUT_PATH=data/vocabulary.json
# ENTITIES_OUTPUT_PATH=data/entities.json
# CHUNK_ENTITIES_OUTPUT=data/chunk_entities.json
# ENTITY_SAMPLE_RATIO=0.05
# ENTITY_REVIEW_ENABLED=true
# ENTITY_REVIEW_BATCH_SIZE=40
# KEYWORDS_PER_CHUNK=20
# CHUNK_KEYWORDS_OUTPUT=data/chunk_keywords.json
# VOCAB_EXCLUDE_ENTITY_TERMS=true
# VOCAB_REVIEW_ENABLED=true
# VOCAB_REVIEW_BATCH_SIZE=40
# VOCAB_REVIEW_REBUILD=true

# 词表/停用词库（默认 SQLite data/lexicon.db；改用 PostgreSQL 时取消注释）
# LEXICON_DB_BACKEND=sqlite
# LEXICON_SQLITE_PATH=data/lexicon.db
# LEXICON_DB_BACKEND=postgres
# LEXICON_DATABASE_URL=postgresql://user:pass@localhost:5432/diary_rag
# 检索评分（覆盖 config.yaml retrieval / tag_score）
# RETRIEVAL_TOP_K=20
# RETRIEVAL_PLAN=tag,embedding
# RETRIEVAL_W_VECTOR=0.7
# RETRIEVAL_W_TAG=0.3
# TAG_ENTITY_WEIGHT=10
# TAG_KEYWORD_WEIGHT=1
# TAG_ENTITY_HIT_BONUS=5
# TAG_USE_KEYWORD_TFIDF=false
# TAG_TOP_K=50

